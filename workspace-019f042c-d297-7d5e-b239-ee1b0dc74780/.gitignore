# JARVIS v3 - Git Ignore
# ======================

# Environment variables (API keys!)
.env

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environment
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# JARVIS runtime files (user data)
memory/*.json
notes/*.txt
screenshots/*.png
logs/*.log

# Don't ignore the example env file
!.env.example
